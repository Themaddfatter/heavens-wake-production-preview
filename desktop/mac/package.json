{
  "name": "heavens-wake-production-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "Heaven's Wake Production for macOS",
  "author": "Zion House of Prayer",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check build-preview.cjs && node --check prepare-icon.cjs && node --check display-manager.cjs && node --check preload.cjs && node --test display-manager.test.cjs",
    "dist:mac": "npm run prepare:icon && electron-builder --mac --universal --publish never",
    "dist:preview": "npm run prepare:icon && node build-preview.cjs",
    "prepare:icon": "node prepare-icon.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.sioncdo.hwp",
    "productName": "HWP",
    "asar": true,
    "files": [
      "main.cjs",
      "package.json",
      "display-manager.cjs",
      "preload.cjs"
    ],
    "directories": {
      "output": "dist"
    },
    "forceCodeSigning": true,
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "HWP uses cameras for production and livestreaming.",
        "NSMicrophoneUsageDescription": "HWP uses microphones and audio inputs for production and livestreaming.",
        "NSLocalNetworkUsageDescription": "HWP connects to production equipment on your local network."
      },
      "icon": "build/icon.icns",
      "artifactName": "HWP-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Themaddfatter",
        "repo": "heavens-wake-production-preview",
        "releaseType": "release"
      }
    ]
  }
}
